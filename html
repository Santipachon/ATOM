<!DOCTYPE html>
<html lang="es-CO">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ATOM DRON COLOMBIA — Reparación y mantenimiento de drones DJI en Bogotá</title>
<meta name="description" content="Taller especializado en reparación de drones DJI en Bogotá. Diagnóstico claro, repuestos originales y entregas en 24 horas. 4.9★ con 276 opiniones en Google. Se atiende con cita previa.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Public+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --ember:#FF4E12;
  --ember-deep:#C42A04;
  --ember-glow:rgba(255,78,18,.16);
  --ink:#16100E;
  --ink-2:#231916;
  --ink-3:#31241F;
  --bone:#EDE9E2;
  --bone-2:#DCD6CC;
  --steel:#8B807A;
  --white:#FFF8F4;

  --display:"Archivo",system-ui,sans-serif;
  --body:"Public Sans",system-ui,sans-serif;
  --mono:"JetBrains Mono",ui-monospace,monospace;

  --maxw:1180px;
  --pad:clamp(20px,5vw,56px);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  background:var(--ink);
  color:var(--bone);
  font-family:var(--body);
  font-size:17px;
  line-height:1.6;
  overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:2.5px solid var(--ember);outline-offset:3px;border-radius:2px}

.wrap{max-width:var(--maxw);margin:0 auto;padding-left:var(--pad);padding-right:var(--pad)}

/* ---------- tipografía ---------- */
.h-xl{
  font-family:var(--display);
  font-variation-settings:"wdth" 112,"wght" 800;
  font-size:clamp(38px,6.4vw,80px);
  line-height:.98;
  letter-spacing:-.025em;
  text-transform:uppercase;
}
.h-lg{
  font-family:var(--display);
  font-variation-settings:"wdth" 108,"wght" 750;
  font-size:clamp(28px,4vw,46px);
  line-height:1.03;
  letter-spacing:-.02em;
  text-transform:uppercase;
}
.h-md{
  font-family:var(--display);
  font-variation-settings:"wdth" 100,"wght" 700;
  font-size:clamp(19px,2vw,22px);
  line-height:1.18;
  letter-spacing:-.01em;
}
.eyebrow{
  font-family:var(--mono);
  font-size:11.5px;
  letter-spacing:.22em;
  text-transform:uppercase;
  color:var(--ember);
  font-weight:500;
}
.lead{font-size:clamp(17px,2vw,20px);color:#C9BFB8;max-width:56ch}
.muted{color:var(--steel)}

/* ---------- barra superior ---------- */
.ticker{
  background:var(--ember-deep);
  color:#FFE9E0;
  font-family:var(--mono);
  font-size:11.5px;
  letter-spacing:.1em;
  text-transform:uppercase;
  padding:9px 0;
  overflow:hidden;
  white-space:nowrap;
}
.ticker-inner{display:flex;gap:34px;align-items:center;justify-content:center;flex-wrap:wrap}
.ticker b{font-weight:700;color:#fff}

/* ---------- header ---------- */
.hdr{
  position:sticky;top:0;z-index:60;
  background:rgba(22,16,14,.86);
  backdrop-filter:blur(14px);
  border-bottom:1px solid rgba(237,233,226,.1);
}
.hdr-in{display:flex;align-items:center;gap:22px;height:70px}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;flex-shrink:0}
.brand-mark{width:38px;height:38px;flex-shrink:0}
.brand-txt{display:flex;flex-direction:column;line-height:1}
.brand-name{
  font-family:var(--display);
  font-variation-settings:"wdth" 118,"wght" 900;
  font-size:19px;letter-spacing:.01em;color:var(--white);
}
.brand-sub{font-family:var(--mono);font-size:8.5px;letter-spacing:.24em;color:var(--steel);margin-top:3px}
.nav{display:flex;gap:26px;margin-left:auto}
.nav a{
  text-decoration:none;font-size:14.5px;color:#BDB2AB;font-weight:500;
  transition:color .18s;
}
.nav a:hover{color:var(--ember)}

.btn{
  display:inline-flex;align-items:center;gap:9px;
  font-family:var(--display);
  font-variation-settings:"wdth" 104,"wght" 700;
  font-size:14px;letter-spacing:.02em;text-transform:uppercase;
  padding:13px 20px;border-radius:3px;text-decoration:none;
  border:1.5px solid transparent;cursor:pointer;
  transition:transform .16s,background .18s,color .18s;
}
.btn:active{transform:translateY(1px)}
.btn-fill{background:var(--ember);color:#160D08}
.btn-fill:hover{background:#FF6832}
.btn-line{border-color:rgba(237,233,226,.32);color:var(--bone)}
.btn-line:hover{border-color:var(--ember);color:var(--ember)}
.btn-lg{padding:17px 28px;font-size:15.5px}
.btn-dark{background:var(--ink);color:var(--white)}
.btn-dark:hover{background:var(--ink-3)}

/* ---------- hero ---------- */
.hero{
  position:relative;overflow:hidden;
  padding:clamp(52px,7vw,88px) 0 clamp(48px,6vw,76px);
  background:
    radial-gradient(120% 90% at 78% 8%,rgba(255,78,18,.28) 0%,rgba(255,78,18,0) 58%),
    radial-gradient(90% 70% at 12% 100%,rgba(196,42,4,.22) 0%,rgba(196,42,4,0) 60%),
    var(--ink);
}
.hero::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background-image:radial-gradient(rgba(237,233,226,.05) 1px,transparent 1px);
  background-size:22px 22px;
  mask-image:linear-gradient(to bottom,rgba(0,0,0,.7),transparent 70%);
}
.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(32px,5vw,64px);align-items:center}
.hero h1{margin:18px 0 20px;color:var(--white)}
.hero h1 em{font-style:normal;color:var(--ember)}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 26px}
.hero-stats{display:flex;gap:26px;flex-wrap:wrap;padding-top:24px;border-top:1px solid rgba(237,233,226,.14)}
.stat-n{font-family:var(--display);font-variation-settings:"wdth" 110,"wght" 800;font-size:26px;color:var(--white);line-height:1}
.stat-l{font-family:var(--mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--steel);margin-top:6px}

/* ---------- orden de servicio (firma) ---------- */
.order{
  background:linear-gradient(168deg,#2A1E19 0%,#1C1411 100%);
  border:1px solid rgba(255,78,18,.3);
  border-radius:5px;
  padding:22px;
  box-shadow:0 26px 60px rgba(0,0,0,.5);
  font-family:var(--mono);
  position:relative;
}
.order::before{
  content:"";position:absolute;left:0;right:0;top:0;height:3px;
  background:linear-gradient(90deg,var(--ember),var(--ember-deep));
  border-radius:5px 5px 0 0;
}
.order-hd{display:flex;justify-content:space-between;align-items:baseline;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel);padding-bottom:14px;border-bottom:1px dashed rgba(237,233,226,.18)}
.order-hd b{color:var(--ember);font-weight:700}
.order-row{display:flex;justify-content:space-between;gap:16px;font-size:12.5px;padding:11px 0;border-bottom:1px solid rgba(237,233,226,.07)}
.order-row span:first-child{color:var(--steel);letter-spacing:.06em;text-transform:uppercase;font-size:10.5px;padding-top:2px}
.order-row span:last-child{color:var(--bone);text-align:right}
.order-steps{margin-top:16px;display:flex;flex-direction:column;gap:9px}
.ostep{display:flex;align-items:center;gap:11px;font-size:12px;color:var(--steel)}
.ostep .dot{width:15px;height:15px;border-radius:50%;border:1.5px solid rgba(237,233,226,.25);flex-shrink:0;display:grid;place-items:center;font-size:9px}
.ostep.done{color:var(--bone)}
.ostep.done .dot{background:var(--ember);border-color:var(--ember);color:#160D08;font-weight:700}
.ostep.now{color:var(--white)}
.ostep.now .dot{border-color:var(--ember);box-shadow:0 0 0 0 var(--ember-glow);animation:pulse 1.9s infinite}
.ostep.now .dot::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--ember)}
@keyframes pulse{70%{box-shadow:0 0 0 11px rgba(255,78,18,0)}100%{box-shadow:0 0 0 0 rgba(255,78,18,0)}}
.order-ft{margin-top:18px;padding-top:14px;border-top:1px dashed rgba(237,233,226,.18);display:flex;justify-content:space-between;align-items:center}
.order-ft .lbl{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel)}
.order-ft .val{font-family:var(--display);font-variation-settings:"wdth" 112,"wght" 800;font-size:26px;color:var(--ember);line-height:1}

/* ---------- secciones ---------- */
.sec{padding:clamp(58px,7vw,96px) 0}
.sec-bone{background:var(--bone);color:var(--ink)}
.sec-bone .lead{color:#59504B}
.sec-bone .eyebrow{color:var(--ember-deep)}
.sec-bone .h-lg,.sec-bone .h-md{color:var(--ink)}
.sec-hd{max-width:62ch;margin-bottom:clamp(30px,4vw,48px)}
.sec-hd h2{margin:14px 0 16px}

/* ---------- síntomas ---------- */
.symp{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(22,16,14,.14);border:1px solid rgba(22,16,14,.14)}
.symp-card{background:var(--bone);padding:26px 24px 28px;transition:background .2s}
.symp-card:hover{background:var(--white)}
.symp-card .ico{color:var(--ember-deep);margin-bottom:16px;display:block}
.symp-card h3{margin-bottom:9px}
.symp-card p{font-size:15px;color:#5C534E}
.symp-card .tag{display:inline-block;margin-top:14px;font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--ember-deep);border:1px solid rgba(196,42,4,.35);padding:4px 9px;border-radius:99px}

/* ---------- modelos ---------- */
.models{display:flex;flex-wrap:wrap;gap:9px;margin-top:8px}
.chip{
  font-family:var(--mono);font-size:12.5px;letter-spacing:.04em;
  padding:9px 15px;border-radius:99px;
  border:1px solid rgba(237,233,226,.2);color:#C4B9B2;
}
.chip.hot{border-color:var(--ember);color:var(--ember);background:rgba(255,78,18,.09)}

/* ---------- proceso ---------- */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:26px;counter-reset:s}
.step{position:relative;padding-top:26px;border-top:2px solid rgba(255,78,18,.35)}
.step::before{
  counter-increment:s;content:"0" counter(s);
  position:absolute;top:-14px;left:0;background:var(--ink);padding-right:12px;
  font-family:var(--mono);font-size:13px;font-weight:700;color:var(--ember);
}
.step h3{margin-bottom:9px}
.step p{font-size:15px;color:#A79C95}

/* ---------- registro de entregas ---------- */
.ledger-sec{background:var(--ink-2);border-top:1px solid rgba(237,233,226,.09);border-bottom:1px solid rgba(237,233,226,.09)}
.ledger{font-family:var(--mono);margin-top:30px;border:1px solid rgba(237,233,226,.12);border-radius:4px;overflow:hidden}
.led-hd,.led-row{display:grid;grid-template-columns:1.1fr 2fr .9fr;gap:18px;padding:13px 20px;align-items:center}
.led-hd{background:rgba(237,233,226,.05);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--steel)}
.led-row{border-top:1px solid rgba(237,233,226,.08);font-size:13px}
.led-row .mdl{color:var(--white);font-weight:500}
.led-row .fll{color:#9C918A}
.led-row .tme{color:var(--ember);text-align:right;font-weight:700;white-space:nowrap}
.led-note{margin-top:14px;font-family:var(--mono);font-size:11px;color:var(--steel);letter-spacing:.04em}

/* ---------- reseñas ---------- */
.rev-top{display:flex;align-items:flex-end;gap:28px;flex-wrap:wrap;margin-bottom:34px}
.score{font-family:var(--display);font-variation-settings:"wdth" 115,"wght" 900;font-size:76px;line-height:.85;color:var(--ink)}
.stars{color:var(--ember);font-size:18px;letter-spacing:3px}
.revs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.rev{background:var(--white);border:1px solid rgba(22,16,14,.1);border-radius:4px;padding:22px}
.rev q{display:block;font-size:16.5px;line-height:1.5;color:var(--ink);quotes:"“" "”"}
.rev .who{margin-top:16px;padding-top:14px;border-top:1px solid rgba(22,16,14,.09);font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#7A716B}
.rev .who b{display:block;color:var(--ink);font-weight:700;letter-spacing:.05em;margin-bottom:3px;text-transform:none;font-size:12.5px}

/* ---------- extras ---------- */
.duo{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.card-dark{background:var(--ink-2);border:1px solid rgba(237,233,226,.12);border-radius:4px;padding:30px}
.card-dark h3{margin:14px 0 10px}
.card-dark p{font-size:15.5px;color:#A79C95}

/* ---------- faq ---------- */
.faq{border-top:1px solid rgba(22,16,14,.16)}
.faq details{border-bottom:1px solid rgba(22,16,14,.16)}
.faq summary{
  list-style:none;cursor:pointer;padding:22px 44px 22px 0;position:relative;
  font-family:var(--display);font-variation-settings:"wdth" 100,"wght" 700;
  font-size:clamp(16.5px,2vw,19px);color:var(--ink);
}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";position:absolute;right:6px;top:19px;font-family:var(--mono);font-size:24px;color:var(--ember-deep);transition:transform .2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq p{padding:0 0 24px;font-size:16px;color:#5C534E;max-width:70ch}

/* ---------- contacto ---------- */
.contact-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(28px,4vw,56px)}
.form{background:var(--ink-2);border:1px solid rgba(237,233,226,.14);border-radius:5px;padding:clamp(22px,3vw,32px)}
.fld{margin-bottom:16px}
.fld label{display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--steel);margin-bottom:7px}
.fld input,.fld select,.fld textarea{
  width:100%;background:var(--ink);border:1px solid rgba(237,233,226,.18);
  border-radius:3px;padding:13px 14px;color:var(--bone);
  font-family:var(--body);font-size:15.5px;
}
.fld textarea{min-height:96px;resize:vertical}
.fld input::placeholder,.fld textarea::placeholder{color:#6B615B}
.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--ember);outline:none}
.form .btn{width:100%;justify-content:center;margin-top:6px}
.form-note{font-family:var(--mono);font-size:11px;color:var(--steel);margin-top:14px;text-align:center;letter-spacing:.03em}

.info-block{border-top:1px solid rgba(237,233,226,.14);padding:20px 0}
.info-block:first-of-type{border-top:none;padding-top:0}
.info-block .k{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--ember);margin-bottom:9px}
.info-block .v{font-size:16.5px;color:var(--bone)}
.info-block a{text-decoration:none;border-bottom:1px solid rgba(255,78,18,.5)}
.hours{font-family:var(--mono);font-size:13.5px}
.hours div{display:flex;justify-content:space-between;padding:5px 0;color:#B3A8A1;max-width:320px}
.hours div b{color:var(--white);font-weight:500}
.badge-cita{
  display:inline-flex;gap:9px;align-items:center;margin-top:6px;
  background:rgba(255,78,18,.12);border:1px solid rgba(255,78,18,.4);
  border-radius:3px;padding:12px 15px;
  font-family:var(--mono);font-size:12px;color:#FFC7AF;line-height:1.45;
}

/* ---------- footer ---------- */
.ftr{background:#0F0B09;padding:44px 0 110px;border-top:1px solid rgba(237,233,226,.09)}
.ftr-in{display:flex;justify-content:space-between;gap:26px;flex-wrap:wrap;align-items:center}
.ftr-links{display:flex;gap:20px;flex-wrap:wrap;font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase}
.ftr-links a{text-decoration:none;color:var(--steel)}
.ftr-links a:hover{color:var(--ember)}
.ftr-legal{font-family:var(--mono);font-size:10.5px;color:#5B524D;letter-spacing:.06em;margin-top:22px;line-height:1.9}

/* ---------- wsp flotante ---------- */
.wsp{
  position:fixed;right:18px;bottom:18px;z-index:80;
  display:flex;align-items:center;gap:10px;
  background:#25D366;color:#07300F;text-decoration:none;
  padding:14px 18px;border-radius:99px;
  font-family:var(--display);font-variation-settings:"wdth" 104,"wght" 700;
  font-size:14px;text-transform:uppercase;letter-spacing:.02em;
  box-shadow:0 12px 34px rgba(0,0,0,.44);
}
.wsp:hover{background:#2EE875}

/* ---------- responsive ---------- */
@media(max-width:1000px){
  .hero-grid,.contact-grid,.duo{grid-template-columns:1fr}
  .symp{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(2,1fr);gap:30px}
  .revs{grid-template-columns:repeat(2,1fr)}
  .nav{display:none}
}
@media(max-width:640px){
  body{font-size:16px}
  .symp,.revs,.steps{grid-template-columns:1fr}
  .hdr .btn{padding:11px 14px;font-size:12.5px}
  .hdr-in{gap:12px}
  .brand-sub{display:none}
  .led-hd{display:none}
  .led-row{grid-template-columns:1fr;gap:4px;padding:15px 16px}
  .led-row .tme{text-align:left}
  .wsp span{display:none}
  .wsp{padding:16px;border-radius:50%}
  .hero-stats{gap:20px}
}
@media(prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
</style>
</head>
<body>

